# ── Google Sheets (service account) ────────────────────────────────
# Local dev: point at the service-account JSON file on disk.
GOOGLE_SERVICE_ACCOUNT_FILE=./bamboo-reports-f3d45a15c2ce.json
# Production (Vercel/Cloud Run): paste the whole JSON here instead and
# leave GOOGLE_SERVICE_ACCOUNT_FILE unset. Base64 of the JSON also works.
# GOOGLE_SERVICE_ACCOUNT_JSON=

SPREADSHEET_ID=1ZTO8x-e6bGLV_-HUJ3Pov8D81BYDAdFx41T6Q3aZAvQ

# ── Auth (Google Sign-In, domain restricted) ───────────────────────
# Create an OAuth 2.0 Web client at console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Comma-separated. Only these domains may sign in.
ALLOWED_EMAIL_DOMAINS=researchnxt.com
# Optional: comma-separated emails allowed to archive (delete) rows.
# Leave empty to let any signed-in user archive.
ADMIN_EMAILS=

# Set to 1 to bypass sign-in entirely on localhost. NEVER set in production.
DEV_AUTH_BYPASS=0

# ── Upstash Redis (shared cache + locks across Vercel instances) ───
# Required in production on Vercel. Without it every serverless instance keeps
# its own cache and lock, which can hand two users the same new record id.
# Leave both unset locally to fall back to in-memory caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
